PORT=3000
JWT_SECRET=change-this-in-production
# 会话 token 有效期（P6-5，默认 7d）：jsonwebtoken 语法——纯数字按秒，或 "30m"/"12h"/"7d"。
# 只管「没被改密时活多久」；改密与管理员重置会让旧 token 立即失效（pwdEpoch 比对，
# 不需要黑名单表），禁用账号也是每请求查库即时生效。
# JWT_EXPIRES_IN=7d
DATABASE_URL=postgres://apitest:apitest@localhost:5432/apitest
# 32-byte AES key for data-source passwords. Accepts 64 hex characters or base64 that decodes to 32 bytes.
# Generate once and keep identical across API, worker and scheduler processes — the scheduler
# decrypts notification-channel signing secrets when dispatching alerts. Never commit the real value.
DATA_SOURCE_ENCRYPTION_KEY=replace-with-64-hex-characters-or-32-byte-base64
# 执行队列。API 进程入队，worker 进程消费，两者必须指向同一个 Redis。
REDIS_URL=redis://localhost:6379
# 单个 worker 进程同时在途的请求数。上调即为提高整体吞吐。
WORKER_CONCURRENCY=10
# 一次**流程**执行同时在飞的叶子步骤数（默认 4，上限 10）。请求节点声明的并发不能超过它
# ——那 N 枚令牌是一次凑齐的，声明更大只会永远凑不齐，所以保存与入队都会直接拒绝。
# API 与 worker 必须一致：保存校验在 API 侧，真正建池在 worker 侧。
# FLOW_PARALLELISM=4
# 一次**套件**执行共享的令牌池容量（默认 8，上限 20）。套件的成员并发（几个成员同时开跑）
# 不能超过它。实际生效值不会低于 FLOW_PARALLELISM：套件池小于流程池会让「单独跑得起来、
# 放进套件就超预算」成立。
# SUITE_LEAF_BUDGET=8
# 这个 worker 消费哪一类任务。目前只有 endpoint；repository 预留，仓库模式上线时用。
# WORKER_MODE=endpoint
# 这个 worker 服务哪些**执行分区**（P2-8，逗号分隔，默认 default）。分区表达「从哪个网段
# 发请求」：队列按标签分裂成 executions-<label>，一个只服务 prod-dmz 的 worker 领不到
# default 的任务，反之亦然。环境上的「执行分区」决定指向它的执行落在哪条队列。
# 标签格式：^[a-z0-9][a-z0-9-]{0,31}$（会进 Redis key，写错会导致任务一直排队没人领）。
# **推荐一个进程只服务一个标签**：多标签时 WORKER_CONCURRENCY 会按标签数均分
# （floor(CONCURRENCY / 标签数)），否则上报的容量会翻倍失真。
# 生产网段那台机器必须能出站到本平台的 Redis 6379 与 Postgres 5432，否则这套模型不成立。
# WORKER_LABELS=default
# ── 调度器进程（第三个进程：pnpm scheduler，start.sh 会一并拉起）──────────────
# 它不消费执行队列、不监听端口，只做三件事：cron tick 认领到期调度、漏跑判定、
# 订阅 executions:events 评估告警。与 API/worker 共用 DATABASE_URL / REDIS_URL /
# DATA_SOURCE_ENCRYPTION_KEY（告警渠道的加签密钥在调度器里解密）。
# 多实例安全（行级认领），但推荐单实例：它不是吞吐瓶颈，多起只会让日志难读。

# 一拍多久扫一次到期调度（默认 10000ms，钳位 1s–60s）。cron 粒度到分钟，10 秒的
# 判定误差远小于「整点跑」的预期；调小只是空转。
# SCHEDULER_TICK_MS=10000
# 漏跑宽限期（默认 120000ms，钳位 30s–1h）：到期时刻超过它还没被认领就记一行
# skipped 并把 next_run_at 快进——不补跑，补跑等于同一刻对被测系统打 N 发。
# SCHEDULER_MISS_GRACE_MS=120000

# ── 仓库模式上报（P4，`POST /ingest`）─────────────────────────────────────────
# 两道硬上限，各挡一种形状（计划 7.2；不做项目级配额）。
# 记录条数上限：超出回 413。默认 20000——一次全量回归的请求数量级在几千，留一倍余量。
# INGEST_MAX_RECORDS=20000
# 请求体字节上限：由 Fastify 的 bodyLimit 在**解析之前**拒掉，比读完再数省一次内存。
# 只在开了 APITRACK_BODY_CAPTURE 的仓库才可能接近它。
# INGEST_MAX_BODY_BYTES=8388608

# ── 自研 Runner（P4.5，/runner/* 协议）─────────────────────────────────────────
# 平台对外根地址：claim 下发的 JobSpec 里 APITRACK_URL 用它；通知模版的 {{reportUrl}}
# 也用它拼完整链接（调度器进程没有请求上下文，这是唯一的地名来源；缺省时占位符渲染
# 成站内相对路径）。平台藏在反代后面、request.hostname 是内网名时必须显式配置，否则
# SDK 上报会打到一个内网地址上。
# PUBLIC_BASE_URL=https://apitrack.example.com
# JobSpec 沙箱限额（平台级默认值，container 档才生效；进程档是信任声明，无隔离）。
# RUNNER_CPU_LIMIT=2
# RUNNER_MEMORY_LIMIT=2g
# RUNNER_DISK_LIMIT=10g
# 容器档出站白名单的反面——拒绝名单（逗号分隔 CIDR）。默认只封云元数据地址；按部署
# 网段把平台内网也加进来，否则「网络隔离」只是封了一个地址的摆设。
# RUNNER_DENY_CIDRS=169.254.169.254/32
# complete 的请求体上限（路由级 bodyLimit，P4.5-6）：cases[] 带整份 junit/allure 报告
# 解析结果，Fastify 默认 1MB 盛不下大报告。Runner 侧有自己的 6MB 载荷预算，调低这里
# 会让 Runner 丢掉 cases 降级重发（终态优先）。
# RUNNER_COMPLETE_MAX_BODY_BYTES=8388608

# ── MCP Server（P5，POST /mcp）───────────────────────────────────────────────
# DNS rebinding 防护的 Host 白名单（P5-3）：/mcp 校验请求的 Host 主机名（端口无关）。
# 默认 localhost / 127.0.0.1 / [::1]，外加 PUBLIC_BASE_URL 的主机名（智能体平台拿到的
# 端点地址从它拼来）。智能体平台走内网域名或 IP 接入时，把那个主机名追加在这里
# （逗号分隔）；`*` 表示完全放开 Host 校验——内网任意 hostname 部署的逃生门，默认不开。
# MCP_ALLOWED_HOSTS=mcp.apitest.internal,192.168.1.10

# ── 产物对象存储（P4.5-7，/runner/artifacts/* 直传与下载直链）─────────────────
# 驱动两档：fs（默认，本地目录，dev 用）与 s3（MinIO / S3，生产）。硬约束：平台永不
# 代理大文件流——Runner 申请直传目标后直传对象存储，浏览器下载走 presignGet 直链。
# ARTIFACT_STORAGE_DRIVER=fs
# fs 驱动的存储根目录（相对路径按进程 CWD 解析；容器部署指到卷上）。
# ARTIFACT_FS_ROOT=data/artifacts
# fs 驱动一次性上传/下载 token 的签名密钥；缺省派生自 JWT_SECRET（生产建议独立配置）。
# ARTIFACT_FS_TOKEN_SECRET=
# s3 驱动三件套：bucket 必填；endpoint 只给 MinIO/自建（带 path-style），AWS 原生留空；
# 凭证走 AWS SDK 默认链（AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / IAM）。
# ARTIFACT_STORAGE_DRIVER=s3
# ARTIFACT_S3_BUCKET=
# ARTIFACT_S3_ENDPOINT=
# ARTIFACT_S3_REGION=us-east-1
# 大响应体转存的落盘上限（P10-1）：执行响应正文超过内联阈值（10KB）且项目开关开着时，
# 完整正文写入上述驱动，超过本上限的只保留行内截断预览（详情页不出现「下载完整响应」）。
# 与 INGEST_MAX_BODY_BYTES / RUNNER_COMPLETE_MAX_BODY_BYTES 的 8MB 口径一致。
# RESPONSE_OFFLOAD_MAX_BYTES=8388608

# ── 执行历史归档（P10-2，executions 按季分区）────────────────────────────────
# 保留窗口（月）。**默认 0 = 自动归档关闭**，scheduler 只预建未来季分区，一行历史都不动。
# 设为正数后，整季都早于 now() - N 个月的分区会被 DETACH 出主表并改名为
# executions_archived_YYYYqN：读侧立刻看不到它（API 只查 executions），但**数据仍在库里、
# 磁盘不释放**——自动维护永不做不可逆的事。
# 真正的清理（同步删除对象存储里的大响应体 + DROP TABLE）走系统管理员端点
# DELETE /api/v1/system/execution-partitions/:name；现状清单在同路径的 GET。
# 直接在 psql 里 DROP 归档表会留下永久孤儿对象，别那么做。
# EXECUTION_RETENTION_MONTHS=0

# ── 资产版本历史（P10-4，asset_versions）─────────────────────────────────────
# 每个资产（接口/接口用例/文本用例/环境）保留的版本上限。**默认 50**，0 = 不裁剪。
# 保存即产出一版，裁剪在落新版的同一事务里做：按版号保留最高的 N 个、删更早的。
# 版号单调递增永不复用——裁剪不改「回滚到第 N 版」的编号所指内容。改此值需重启进程。
# ASSET_VERSION_RETENTION=50

# ── SQL 执行历史（P2-1 增量，sql_execution_history）──────────────────────────
# 交互式查询面板 /query 的执行历史，三层淘汰任一触发即生效。改这三个值需重启进程。
# 单条预览的字节上界：写入前独立截断（前 50 行 / 本字节数先到先停），与执行器返回多大无关。
# 保证单条历史体积恒定。**默认 32768（32KB）**。
# SQL_HISTORY_PREVIEW_BYTES=32768
# 环形缓冲：每 (用户, 数据源) 只留最近 N 条，插入后删更早的。**默认 50**。
# SQL_HISTORY_KEEP_PER_USER=50
# TTL（天）：scheduler 每 6h 删早于 now()-N 天的历史。**默认 14**，0 = 关闭 TTL
# （环形缓冲与单条上限仍生效）。
# SQL_HISTORY_TTL_DAYS=14

# ── 站内助手（P9，/api/v1/assistant/*）───────────────────────────────────────
# 空库首次启动的默认上游地址（provider 名固定 agent-vendor-agent，协议 = agent-vendor 通用形状）。
# 按名字幂等插入（已存在则不动，绝不覆盖管理员的协议/默认位）；空库时它自动成为默认。
# 空库开箱要用助手就配它；留空则跳过种子（管理员到系统管理 → 助手 provider 手配）。
# agent-vendor_BASE_URL=http://stgstplatform.***.net:8089
