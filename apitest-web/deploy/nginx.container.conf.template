# apitest-web 反向代理模板（容器部署，单机 docker run，无 compose）
#
# 前端只走容器部署：无独立于容器的裸机 nginx 版本（曾有 deploy/nginx.conf，已删）。
# 容器内 nginx 的三条特性：
#   1. upstream 后端地址来自环境变量 ${BACKEND_UPSTREAM}，容器启动时由 nginx 官方
#      镜像的 envsubst 入口注入，所以本文件是 `*.template` 而非直接可用的 conf。
#      $host / $uri 等 nginx 变量不是环境变量，不会被替换，保持原样。
#   2. 容器内 TLS 交给外层（宿主 nginx / LB / ingress）终结，这里只 listen 80。
#   3. root 指向镜像内的 /usr/share/nginx/html（vite build 产物 COPY 到此处）。
#
# 后端地址示例（见 DOCKER_DEPLOY.md）：
#   -e BACKEND_UPSTREAM=host.docker.internal:3000   # 后端在宿主机
#   -e BACKEND_UPSTREAM=10.0.0.12:3000              # 后端在另一台机器

upstream apitest_backend {
    server ${BACKEND_UPSTREAM};
    keepalive 32;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 上传体：导入用例 / 附件等留足余量
    client_max_body_size 32m;

    # 项目**集合**端点（列表 / 新建）走常规转发：`location ^~ /api/v1/projects/` 以斜杠结尾，
    # nginx 对「同前缀但无斜杠」的 `proxy_pass` 请求会自动 301 到带斜杠版本，而 `/api/v1/projects`
    # 恰好是集合端点——被重定向成 `/api/v1/projects/` 后后端按 `:id=""` 解析，报 500
    # 「invalid input syntax for type uuid: ""」，前端表现为「项目加载失败」。故此处用精确
    # 匹配把它钉住（`=` 优先于任何前缀匹配，也优先于 SSE 块），SSE 只服务带子路径的请求。
    location = /api/v1/projects {
        proxy_pass http://apitest_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # SSE 长连接：执行流 / 助手对话流。必须放在通用 /api/ 之前，关缓冲、拉长超时。
    location ^~ /api/v1/projects/ {
        proxy_pass http://apitest_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # SPA 自己的 API 请求：同源转发到后端
    location /api/ {
        proxy_pass http://apitest_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # 外部可直接调用的根路径端点（不带 /api/v1 前缀）：
    #   /mock/:publicId/*  Mock 回放
    #   /mcp               MCP 端点
    #   /ingest            SDK 上报
    location ~ ^/(mock|mcp|ingest)(/|$) {
        proxy_pass http://apitest_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # 带 hash 的构建资源：长缓存
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA 路由回退：其余路径交给前端路由
    location / {
        try_files $uri $uri/ /index.html;
    }
}
